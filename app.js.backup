// app.js
const express = require('express');
const path = require('path');
const app = express();
const port = 3001;

// ===== CORS =====
app.use((req, res, next) => {
  console.log(`📨 ${req.method} ${req.url} depuis ${req.get('Origin') || 'aucune origine'}`);
  
  res.header('Access-Control-Allow-Origin', '*');
  res.header('Access-Control-Allow-Methods', 'GET, POST, PUT, DELETE, OPTIONS');
  res.header('Access-Control-Allow-Headers', 'Origin, X-Requested-With, Content-Type, Accept, Authorization');
  
  if (req.method === 'OPTIONS') {
    console.log('🔄 Requête OPTIONS (preflight) reçue');
    return res.status(200).end();
  }
  
  next();
});

// Middleware JSON
app.use(express.json());

// Route racine
app.get('/', (req, res) => {
  res.sendFile(path.join(__dirname, 'index.html'));
});

// --- ROUTES API ---
app.post('/api/auth/login', (req, res) => {
  console.log('🔐 Tentative de connexion:', req.body);
  
  const { email, password } = req.body;

  if (!email || !password) {
    return res.status(400).json({ message: 'Email et mot de passe requis' });
  }

  if (email === 'test@example.com' && password === '123456') {
    console.log('✅ Connexion réussie pour:', email);
    return res.status(200).json({
      message: 'Connexion réussie',
      token: 'votre-faux-jwt-token',
      user: { pseudo: 'TestUser', email }
    });
  } else {
    console.log('❌ Identifiants invalides pour:', email);
    return res.status(401).json({ message: 'Identifiants invalides' });
  }
});

app.post('/api/auth/register', (req, res) => {
  console.log('📝 Tentative d\'inscription:', req.body);
  
  const { email, password, pseudo } = req.body;

  if (!email || !password || !pseudo) {
    return res.status(400).json({ message: 'Email, mot de passe et pseudo requis' });
  }

  console.log('✅ Inscription réussie pour:', pseudo);
  return res.status(201).json({
    message: 'Inscription réussie',
    token: 'nouveau-faux-jwt-token',
    user: { pseudo, email }
  });
});

app.get('/test', (req, res) => {
  console.log('🧪 Route de test appelée');
  res.json({ 
    message: '🚀 Serveur fonctionne !', 
    timestamp: new Date().toISOString(),
    cors: 'activé'
  });
});

// --- SERVEUR ---
app.listen(port, '127.0.0.1', () => {
  console.log(`✅ Serveur démarré sur:`);
  console.log(`   🌐 http://127.0.0.1:${port}`);
  console.log(`   📝 Test: http://127.0.0.1:${port}/test`);
  console.log(`   📄 Interface: http://127.0.0.1:${port}/`);
});